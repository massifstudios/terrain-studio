#version 450

/*
 * Releases an even depth of sediment over the whole grid. Mirrors the loop at
 * the top of each Deposit iteration in erosion_nodes.cpp.
 */

#extension GL_GOOGLE_include_directive : require
#include "erosion_common.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Target { float target[]; };

layout(push_constant) uniform Settings {
    int count;
    float amount;
} settings;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(settings.count)) {
        return;
    }
    target[index] = target[index] + settings.amount;
}
