#version 450

/*
 * Folds a pass of accumulated change back into a surface. Mirrors `applyDelta`
 * in erosion_nodes.cpp, and the read back out of fixed point is a division
 * rather than a multiply by the reciprocal because that is what the host does.
 */

#extension GL_GOOGLE_include_directive : require
#include "erosion_common.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Target { float target[]; };
layout(std430, binding = 1) readonly buffer Delta { int delta[]; };

layout(push_constant) uniform Settings {
    int count;
} settings;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(settings.count)) {
        return;
    }
    precise float change = terrainDivide(float(delta[index]), unitsPerMeter);
    target[index] = target[index] + change;
}
