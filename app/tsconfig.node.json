{
	"include": [
		"electron.vite.config.ts",
		"src/main/**/*",
		"src/preload/**/*",
		"src/engine/**/*",
		"src/shared/**/*"
	],
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2023",
			"DOM"
		],
		"types": [
			"node",
			"electron",
			"bun"
		],
		"strict": true,
		"noUnusedLocals": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	}
}
